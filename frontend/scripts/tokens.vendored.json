{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "aurora-ai",
    "version": "1.0.0",
    "description": "Aurora AI design tokens — single source of truth. Two-palette architecture: brand (Tier-1 IB for deliverables) + ui (Aether Mesh dark for Tauri app). Sacred lime #CCFF00 — Hybrid bridge.",
    "lastUpdated": "2026-04-24",
    "generatedTargets": ["css", "python", "pptx-theme-xml"],
    "vendored": "Mirror of D:/Docs/Aurora_Ai/06_Aurora_Design_system/01_Tokens/tokens.json (CI-only fallback; sync на любое изменение SSOT)"
  },

  "color": {
    "$type": "color",
    "$description": "Aurora AI two-palette system. `brand.*` → PPTX/DOCX/PDF deliverables. `ui.*` → Tauri webview app. `data.*` → charts (shared).",

    "brand": {
      "$description": "Tier-1 IB palette for client deliverables (navy + gold). WCAG AA/AAA verified.",
      "deep": {
        "100": { "$value": "#0A1628", "$description": "Text primary, section numbers, dark headers. Contrast on white 17.2:1 (AAA)." },
        "80":  { "$value": "#1E3A5F", "$description": "Secondary text, subtle emphasis. Contrast 10.8:1 (AAA)." },
        "60":  { "$value": "#547090", "$description": "Breadcrumbs, footnotes, captions. Contrast 4.6:1 (AA)." },
        "40":  { "$value": "#99ADC2", "$description": "Disabled, muted, secondary data in charts." },
        "20":  { "$value": "#D6DFE8", "$description": "Background tint, subtle table stripes." }
      },
      "gold": {
        "primary": { "$value": "#C5A46D", "$description": "ACCENT — one highlight per slide. Large text 18pt+ only on white." },
        "muted":   { "$value": "#8C7142", "$description": "Accent text on light backgrounds when primary fails contrast." }
      },
      "bg": {
        "white":  { "$value": "#FFFFFF", "$description": "Default slide background." },
        "quiet":  { "$value": "#F7F5EE", "$description": "Fun theme / warm neutral for print emphasis." }
      },
      "rule":    { "$value": "#C8CDD4", "$description": "Gridlines, table borders, hairlines. Max 0.75pt." },
      "text": {
        "primary":   { "$value": "{color.brand.deep.100}", "$description": "Alias: body text." },
        "secondary": { "$value": "{color.brand.deep.60}",  "$description": "Alias: sources, footnotes." }
      },
      "sig": {
        "lime": { "$value": "#CCFF00", "$description": "SACRED signature-lime (Hybrid DECISION). 2pt line under action titles. NEVER other use." }
      }
    },

    "ui": {
      "$description": "Aether Mesh dark palette for Tauri webview app. Not for deliverables.",
      "accent": {
        "primary":   { "$value": "#2E5BFF", "$description": "Primary blue for Svelte components, buttons, links." },
        "secondary": { "$value": "{color.brand.sig.lime}", "$description": "Shared sacred lime (bridge to deliverables)." }
      },
      "bg": {
        "main":    { "$value": "#0f1117", "$description": "App background (dark)." },
        "surface": { "$value": "#1a1d27", "$description": "Card background, elevated panels." },
        "border":  { "$value": "#2a2d37", "$description": "Subtle borders, dividers." }
      },
      "text": {
        "primary":   { "$value": "#EAEAF0", "$description": "Main text on dark." },
        "secondary": { "$value": "#A8A8B8", "$description": "Secondary labels, placeholder." },
        "muted":     { "$value": "#7A7A90", "$description": "Disabled, hints." }
      }
    },

    "semantic": {
      "$description": "Status colors — traffic lights. ONLY for heat maps, statuses, badges. NEVER decor.",
      "success":  { "$value": "#10B981", "$description": "UI success state." },
      "warning":  { "$value": "#F59E0B", "$description": "UI warning state." },
      "danger":   { "$value": "#EF4444", "$description": "UI danger state." },
      "info":     { "$value": "#22D3EE", "$description": "UI info state." },
      "stop":     { "$value": "#ED2124", "$description": "Deliverables heat map — stop/red." },
      "caution":  { "$value": "#F1C44D", "$description": "Deliverables heat map — caution/amber." },
      "go":       { "$value": "#269924", "$description": "Deliverables heat map — go/green." }
    },

    "data": {
      "$description": "Data-viz palette: 7 hues × 5 luminance steps. Used in charts across both palettes. Max 5 concurrent on slide.",
      "ocean":     { "$value": "#0A6F7A", "$description": "1st series — teal." },
      "jade":      { "$value": "#3EB661", "$description": "2nd series — green." },
      "berry":     { "$value": "#D3086F", "$description": "3rd series — magenta." },
      "tangerine": { "$value": "#FA823C", "$description": "4th series — orange." },
      "purple":    { "$value": "#6633CC", "$description": "5th series — violet." },
      "aqua":      { "$value": "#4CCACD", "$description": "6th series — cyan." },
      "peach":     { "$value": "#FF7E81", "$description": "7th series — coral." }
    }
  },

  "typography": {
    "$description": "Aurora typography contract. Office stack (Georgia/Arial/Consolas) embedded in PPTX/DOCX/PDF deliverables. UI stack (Noto Serif/Inter/JetBrains Mono) for Tauri webview.",

    "fontFamily": {
      "$type": "fontFamily",
      "serif":    { "$value": "Georgia",         "$description": "Deliverable headings. Windows/Office EULA permits embed in client deliverables." },
      "sans":     { "$value": "Arial",           "$description": "Deliverable body + labels." },
      "mono":     { "$value": "Consolas",        "$description": "Deliverable mono — IDs, SHA, formulas." },
      "uiSerif":  { "$value": "Noto Serif",      "$description": "Tauri UI headings (SIL OFL 1.1)." },
      "uiSans":   { "$value": "Inter",           "$description": "Tauri UI body (SIL OFL 1.1)." },
      "uiMono":   { "$value": "JetBrains Mono",  "$description": "Tauri UI code (SIL OFL 1.1)." }
    },

    "fontSize": {
      "$type": "dimension",
      "$description": "PPTX sizes in points; CSS sizes in rem (base 16px).",

      "pptx": {
        "coverTitle":     { "$value": "32pt", "$description": "Cover page — Title Case" },
        "coverSubtitle":  { "$value": "16pt", "$description": "Cover subtitle — Sentence case" },
        "sectionNumber":  { "$value": "120pt", "$description": "Section divider big number" },
        "sectionName":    { "$value": "36pt", "$description": "Section divider name" },
        "actionTitle":    { "$value": "24pt", "$description": "Content slide top — Georgia Bold" },
        "subtitle":       { "$value": "14pt", "$description": "Optional under action title" },
        "bodyKM":         { "$value": "20pt", "$description": "Key Message mode body" },
        "bodyDetail":     { "$value": "12pt", "$description": "Detail mode body" },
        "caption":        { "$value": "10pt", "$description": "Chart labels, tooltips" },
        "footnote":       { "$value": "8pt",  "$description": "Sources, breadcrumb" },
        "mono":           { "$value": "10pt", "$description": "Consolas — IDs/hashes" }
      },

      "docx": {
        "h1":     { "$value": "18pt" },
        "h2":     { "$value": "14pt" },
        "h3":     { "$value": "12pt" },
        "body":   { "$value": "11pt" },
        "footnote": { "$value": "9pt" },
        "pageNum":  { "$value": "9pt" }
      },

      "ui": {
        "h1":   { "$value": "2rem",    "$description": "32px — page heading" },
        "h2":   { "$value": "1.5rem",  "$description": "24px" },
        "h3":   { "$value": "1.25rem", "$description": "20px" },
        "body": { "$value": "1rem",    "$description": "16px" },
        "sm":   { "$value": "0.875rem","$description": "14px — captions" },
        "xs":   { "$value": "0.75rem", "$description": "12px — labels" }
      }
    },

    "fontWeight": {
      "light":   { "$value": 300 },
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "bold":    { "$value": 700 }
    },

    "lineHeight": {
      "tight":  { "$value": 1.0 },
      "snug":   { "$value": 1.15 },
      "normal": { "$value": 1.5 }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "4px base unit. Used for UI padding/margins (rem) and PPTX text box insets (pt).",
    "0":  { "$value": "0" },
    "1":  { "$value": "0.25rem", "$description": "4px" },
    "2":  { "$value": "0.5rem",  "$description": "8px" },
    "3":  { "$value": "0.75rem", "$description": "12px" },
    "4":  { "$value": "1rem",    "$description": "16px" },
    "6":  { "$value": "1.5rem",  "$description": "24px" },
    "8":  { "$value": "2rem",    "$description": "32px" },
    "12": { "$value": "3rem",    "$description": "48px" },
    "16": { "$value": "4rem",    "$description": "64px" }
  },

  "sizing": {
    "$description": "PPTX-specific dimensions (inches) + UI dimensions.",
    "pptx": {
      "slideWidth":   { "$value": "13.333in", "$description": "16:9 aspect" },
      "slideHeight":  { "$value": "7.5in" },
      "safeArea":     { "$value": "0.4in",    "$description": "Margin from edges for footer/page num/logo" },
      "gridGutter":   { "$value": "0.2in",    "$description": "Between columns (3-4 col grid)" },
      "logoCover":    { "$value": "0.4in",    "$description": "Top-left big logo on cover" },
      "logoSmall":    { "$value": "0.2in",    "$description": "Bottom-left mono icon on content slides" },
      "signatureLimeWidth": { "$value": "2pt", "$description": "Sacred lime stroke width" },
      "signatureLimeOffset": { "$value": "6pt", "$description": "Gap below action title" }
    },
    "ui": {
      "containerMax": { "$value": "1280px" },
      "sidebarWidth": { "$value": "240px" }
    }
  },

  "border": {
    "$description": "Hairlines and dividers.",
    "width": {
      "hairline": { "$value": "0.75pt",  "$description": "Gridlines, table borders — per Standards/02 max" },
      "signature":{ "$value": "2pt",     "$description": "Sacred lime only" }
    },
    "radius": {
      "none": { "$value": "0" },
      "sm":   { "$value": "2px" },
      "md":   { "$value": "4px" },
      "lg":   { "$value": "8px" }
    }
  }
}
