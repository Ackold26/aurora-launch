{
  "name": "aurora-launch-frontend",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "npm run gen:types && svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:components": "vitest run tests/unit/TrustScore.test.ts tests/unit/SensitivityScenarios.test.ts tests/unit/CommandPalette.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "lint": "eslint .",
    "format": "prettier --write .",
    "histoire": "histoire dev",
    "histoire:build": "histoire build",
    "gen:types": "node scripts/generate-types.mjs",
    "gen:tokens": "node scripts/generate-tokens-css.mjs",
    "check:tokens": "node scripts/check-tokens-vendored.mjs",
    "sync:tokens": "node scripts/sync-tokens-vendored.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "AURORA_BUILD_PROFILE=production tauri build",
    "tauri:build:dev": "AURORA_BUILD_PROFILE=dev tauri build --debug",
    "bundle-stats": "vite-bundle-visualizer"
  },
  "devDependencies": {
    "@histoire/plugin-svelte": "^0.17.17",
    "@playwright/test": "^1.48.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^2.1.0",
    "axe-playwright": "^2.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-svelte": "^2.44.0",
    "histoire": "^0.17.17",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "chart.js": "^4.4.0",
    "katex": "^0.16.47",
    "svelte-i18n": "^4.0.0"
  }
}
